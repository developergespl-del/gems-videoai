# ─────────────────────────────────────────────────────────────
# GEMS Video AI — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────
# Railway: auto-set when you add the PostgreSQL plugin
# Supabase: Settings → Database → Connection string (URI mode)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Auth ──────────────────────────────────────────────────────
# Generate a strong random string: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=change_me_to_a_long_random_string

# ── AI (Gemini) ───────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── AWS S3 (video storage) ────────────────────────────────────
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET=your_s3_bucket_name
AWS_REGION=ap-south-1

# ── Redis (Upstash — cloud Redis for job queue) ───────────────
# Get from: https://console.upstash.com → Create Database
UPSTASH_REDIS_URL=https://your-db.upstash.io
UPSTASH_REDIS_TOKEN=your_upstash_token

# ── Supabase (real-time video progress broadcast) ─────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ── CORS (API server only) ────────────────────────────────────
# Set to your frontend Railway URL to restrict cross-origin access.
# Multiple origins: comma-separated. Leave empty to allow all origins.
CORS_ORIGIN=https://your-frontend.up.railway.app

# ── Frontend only (set in Railway frontend service) ───────────
# The public URL of your API server Railway service.
VITE_API_BASE_URL=https://your-api.up.railway.app

# ── Server (Railway sets PORT automatically — do not override) ─
# PORT=8080
# NODE_ENV=production
